{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "audx",
  "description": "Documentation for audx, the open-source UI sound effects library for React, Next.js and the web: 43 semantic interaction sounds in 4 themes, synthesized with the Web Audio API and installed as code you own.",
  "colors": {
    "primary": "#1447E6",
    "light": "#51A2FF",
    "dark": "#193CB8"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/react",
          "guides/nextjs",
          "guides/frameworks",
          "guides/themes",
          "guides/custom-themes",
          "guides/designing-sounds",
          "guides/best-practices",
          "guides/configuration",
          "guides/migrate-from-use-sound"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/sounds",
          "reference/core-api",
          "reference/react-api",
          "reference/sound-definition"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Browse sounds",
          "href": "https://audx.site",
          "icon": "waveform-lines"
        },
        {
          "anchor": "Showcase",
          "href": "https://audx.site/showcase",
          "icon": "sparkles"
        },
        {
          "anchor": "Changelog",
          "href": "https://audx.site/changelog",
          "icon": "clock-rotate-left"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "npm",
        "href": "https://www.npmjs.com/package/@litlab/audx"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/ommgh/audx"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Browse sounds",
      "href": "https://audx.site"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.audx.site"
    },
    "organization": {
      "id": "https://audx.site/#organization",
      "name": "audx",
      "url": "https://audx.site",
      "logo": "https://audx.site/audx-logo.svg",
      "sameAs": [
        "https://github.com/ommgh/audx",
        "https://www.npmjs.com/package/@litlab/audx"
      ]
    }
  },
  "integrations": {
    "ga4": {
      "measurementId": "G-M5NFPNE1Y5"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ommgh/audx",
      "website": "https://audx.site"
    }
  }
}
